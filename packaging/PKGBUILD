pkgname=dedsecai-studio
pkgver=0.3.0
pkgrel=1
pkgdesc='Local AI studio: GGUF catalog, chat, memory and hardware profiles'
arch=('any')
license=('MIT')
depends=('python' 'tk' 'xdg-utils')
optdepends=('cmake: build llama.cpp' 'gcc: build llama.cpp' 'shaderc: Vulkan shader compiler' 'vulkan-headers: Vulkan build' 'vulkan-icd-loader: Vulkan backend' 'xterm: Pi terminal')
source=("DedsecAI-Studio-${pkgver}-arch.tar.gz")
sha256sums=('SKIP')
package() {
    local studio_root="$srcdir/DedsecAI-Studio-$pkgver"
    install -dm755 "$pkgdir/opt/dedsecai-studio" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications" "$pkgdir/usr/share/licenses/$pkgname"
    cp -a "$studio_root/." "$pkgdir/opt/dedsecai-studio/"
    printf '%s\n' '#!/bin/sh' 'exec /usr/bin/python3 /opt/dedsecai-studio/cli.py "$@"' > "$pkgdir/usr/bin/dedsecai"
    chmod 755 "$pkgdir/usr/bin/dedsecai"
    printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=DedsecAI Studio' 'Exec=/usr/bin/dedsecai web' 'Icon=applications-development' 'Terminal=false' 'Categories=Development;' > "$pkgdir/usr/share/applications/dedsecai-studio.desktop"
    install -m644 "$studio_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
